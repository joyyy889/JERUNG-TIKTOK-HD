# Copy to .env on the VPS. Never commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=4317
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-new-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4317/auth/google/callback
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_SAME_SITE=lax
MAX_UPLOAD_MB=500
PROCESSING_CONCURRENCY=1
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# Dedicated MySQL database and user for Project 3 only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jerung_studio
DB_USER=jerung_studio_user
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10
