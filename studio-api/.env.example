# Copy to .env on the VPS. Never commit real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=4317
API_KEY=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=500
PROCESSING_CONCURRENCY=1
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# Dedicated MySQL database and user for Project 3 only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jerung_studio
DB_USER=jerung_studio_user
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10
